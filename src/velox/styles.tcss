$primary: #fcc179;
$surface: #202020;

/* ================== */
/* Universal Elements */
/* ================== */

#logo {
    width: 100%;
    color: $primary;
    text-style: bold;
    margin-top: 1;
    content-align: center middle;
}

.input {
    width: 30;
    margin-top: 1;
}

.input:focus {
    background: $primary;
    color: $background;
}

.btn {
    width: 30;
    margin-top: 1;
}

.btn:focus {
    background: $primary;
    color: $background;
}

.btn:disabled {
    text-opacity: 0.4;
    background: $surface;
    color: $text-muted;
    border: tall $surface;
}

.select {
    width: 30;
}

.select:focus {
    background: $primary;
    color: $background;
}

.footer {
    dock: bottom;
    width: 100%;
    height: 1;
    color: $primary;
    background: $surface;
    content-align: right middle;
}

/* ================ */
/* Main Menu Screen */
/* ================ */

#menu-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

.optionslist {
    width: 30;
    height: auto;
}

.optionslist ListItem {
    height: 1;
}

.optionslist ListItem Label {
    width: 100%;
    text-align: center;
    color: $primary;
}

#server-status {
    width: 30;
    height: auto;
    margin-top: 1;
    padding: 1 2;
    border: round $primary;
    background: $surface;
    content-align: center top;
    text-align: center;
}

/* ==================== */
/* Configuration Screen */
/* ==================== */

#config-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#config-container Label {
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

/* ========================= */
/* Server Information Screen */
/* ========================= */

#server-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#server-container .info-label {
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

#server-container .info-sub {
    color: $primary;
    margin-top: 1;
}

#server-container .info-value {
    margin-top: 0;
}

/* ==================== */
/* Run Benchmark Screen */
/* ==================== */

#run-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#run-container Label {
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

/* ======================= */
/* Active Benchmark Screen */
/* ======================= */

#active-benchmark-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#active-benchmark-container .stats-header {
    width: 100%;
    height: 1;
    align: center middle;
}

#active-benchmark-container .stats-header Label {
    color: $primary;
    text-style: bold;
    width: 1fr;
    text-align: center;
}

#active-benchmark-container #progress {
    width: 100%;
    margin-top: 1;
}

#active-benchmark-container #progress > .bar--bar {
    color: $primary;
}

#active-benchmark-container .plot-title {
    color: $primary;
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-top: 1;
}

#active-benchmark-container PlotWidget {
    width: 100%;
    height: 10;
    margin-top: 1;
}

#active-benchmark-container .stats-grid {
    grid-size: 6 2;
    grid-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
    width: 100%;
    height: auto;
    margin-top: 1;
}

#active-benchmark-container .stat-label {
    color: $primary;
    text-style: bold;
    text-align: center;
}

#active-benchmark-container .stat-value {
    color: $text;
    text-align: center;
}

/* ========================= */
/* Benchmark Details Screen  */
/* ========================= */

#details-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#details-title {
    color: $primary;
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-top: 1;
}

#verdict-panel {
    width: 60;
    height: auto;
    align: center middle;
    margin-top: 1;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#verdict-panel .verdict-label {
    color: $text-muted;
    text-style: bold;
    width: 100%;
    text-align: center;
}

#verdict-panel .verdict-value {
    color: $primary;
    text-style: bold;
    width: 100%;
    text-align: center;
}

#verdict-panel #verdict-message {
    color: $text;
    width: 100%;
    text-align: center;
}

#details-container .stats-grid {
    grid-size: 4 2;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-rows: 4 4;
    width: 72;
    height: auto;
    margin-top: 1;
}

#details-container .stat-card {
    height: 4;
    padding: 0 1;
    border: round $surface;
    background: $surface;
}

#details-container .stat-card .stat-label {
    color: $text-muted;
    text-style: bold;
    width: 100%;
    text-align: center;
}

#details-container .stat-card .stat-value {
    color: $primary;
    width: 100%;
    text-align: center;
}

#details-meta {
    color: $text-muted;
    width: 100%;
    text-align: center;
    margin-top: 1;
}

/* ======================== */
/* Benchmark History Screen */
/* ======================== */

.btn-history {
    width: 70;
    margin-top: 1;
}

.btn-history:focus {
    background: $primary;
    color: $background;
}

#history-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#history-table {
    width: 70;
    height: auto;
}

.history-list {
    width: 100%;
    height: auto;
}

.history-list ListItem {
    height: 1;
}

.history-list ListItem.highlight {
    background: $primary;
}

.history-list ListItem.highlight Label {
    color: $background;
}

.row {
    height: 1;
}

.cell {
    width: auto;
}

.cell-date {
    width: 20;
}

.cell-scenario {
    width: 16;
}

.cell-duration {
    width: 10;
}

.cell-ramp_up {
    width: 10;
}

.cell-workers {
    width: 10;
}

#history-table > .row Label {
    color: $primary;
    text-style: bold;
}

/* ============ */
/* Error Screen */
/* ============ */

#error-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#error-title {
    color: #e5484d;
    text-style: bold;
    margin-top: 1;
}

#error-message {
    color: $primary;
    margin-top: 1;
}

#error-detail {
    color: $text;
    margin-top: 1;
}